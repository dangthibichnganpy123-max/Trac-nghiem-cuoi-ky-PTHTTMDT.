            { q: "118. Quy trình phát triển hệ thống thương mại điện tử bao gồm mấy bước?", o: ["A. 9", "B. 8", "C. 7", "D. 6"], a: "A" },
            { q: "119. Có mấy nguyên tắc trong phát triển hệ thống?", o: ["A. 10", "B. 9", "C. 8", "D. 7"], a: "D" },
            { q: "120. Nguyên tắc nào dưới đây không phải nguyên tắc trong phát triển hệ thống?", o: ["A. Tránh việc hủy bỏ hoặc sửa phạm vi", "B. Sử dụng một cách tiếp cận hợp lý để giải quyết vấn đề", "C. Tài liệu hóa suốt quá trình phát triển", "D. Cân đối hệ thống với vốn đầu tư"], a: "D" },
            { q: "121. Nhận định nào dưới đây là đúng về đặc điểm của hệ thống thương mại điện tử", o: ["A. Thường được thiết kế vượt ra ngoài phạm vi của một doanh nghiệp", "B. Luôn chấp nhận thay đổi", "C. Loại bỏ những hạn chế trong truyền thống", "D. Tất cả các đáp án trên"], a: "D" },
            { q: "122. Hệ thống thương mại điện tử được mô tả thông qua việc trả lời các câu hỏi nào?", o: ["A. Ai, cái gì, ở đâu, khi nào, tại sao, như thế nào, bao nhiêu, với cái gì", "B. Ai, cái gì, ở đâu, khi nào, tại sao, như thế nào", "C. Ai, cái gì, ở đâu, khi nào, tại sao, như thế nào, bao nhiêu", "D. Ai, cái gì, ở đâu, khi nào, tại sao, như thế nào, với cái gì"], a: "D" },
            { q: "123. Hệ thống ứng dụng thương mại điện tử nào dưới đây làm cầu nối giữa doanh nghiệp với các tổ chức bên ngoài, với các cá nhân cá bên trong và bên ngoài cá nhân?", o: ["A. Trung gian điện tử", "B. Tiện ích thông tin", "C. Tuỳ biến các hoạt động marketing", "D. Tất cả các đáp án trên"], a: "A" },
            { q: "124. Việc đánh giá lại, điều chỉnh chi phí, phạm vi nếu phạm vi mở rộng thêm trong nguyên tắc 'Không né tránh việc hủy bỏ hoặc sửa phạm vi' khi phát triển hệ thống do ai quyết định?", o: ["A. Do người phân tích quyết định", "B. Do người đưa ra giải pháp quyết định", "C. Do người quản trị doanh nghiệp quyết định", "D. Do tổ chức quyết định"], a: "C" },
            { q: "125. Việc thu hẹp phạm vi nếu ngân sách, thời gian bị co lại trong nguyên tắc 'Không né tránh việc hủy bỏ hoặc sửa phạm vi' khi phát triển hệ thống do ai quyết định?", o: ["A. Do người đưa ra giải pháp quyết định", "B. Do người quản trị doanh nghiệp quyết định", "C. Do tổ chức quyết định", "D. Do người phân tích quyết định"], a: "B" }
        ];

        const quizContainer = document.getElementById('quiz-container');
        
        // Tự động tạo giao diện câu hỏi
        questions.forEach((q, index) => {
            const qDiv = document.createElement('div');
            qDiv.classList.add('question-box');
            
            let optionsHTML = '';
            q.o.forEach((opt) => {
                let optionLetter = opt.trim().charAt(0); 
                optionsHTML += `
                    <label class="option">
                        <input type="radio" name="q${index}" value="${optionLetter}">
                        ${opt}
                    </label>
                `;
            });

            qDiv.innerHTML = `
                <div class="question-text">${q.q}</div>
                ${optionsHTML}
            `;
            quizContainer.appendChild(qDiv);
        });

        // Hàm chấm điểm
        function submitQuiz() {
            let score = 0;
            let unanswered = 0;
            
            questions.forEach((q, index) => {
                const selected = document.querySelector(`input[name="q${index}"]:checked`);
                if (selected) {
                    if (selected.value === q.a) {
                        score++;
                    }
                } else {
                    unanswered++;
                }
            });
            
            const resultDiv = document.getElementById('result');
            resultDiv.style.display = 'block';
            
            let msg = `Bạn trả lời đúng ${score} / ${questions.length} câu.`;
            if (unanswered > 0) {
                msg += `<br><span style="font-size: 16px; color: #555;">(Bạn còn ${unanswered} câu chưa làm)</span>`;
            }
            resultDiv.innerHTML = msg;
            
            // Cuộn xuống kết quả
            resultDiv.scrollIntoView({ behavior: 'smooth' });
        }
    </script>
</body>
</html>
