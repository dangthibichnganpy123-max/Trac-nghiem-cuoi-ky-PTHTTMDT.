<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bài Trắc Nghiệm PTHTTMDT (125 Câu)</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 800px; margin: 20px auto; padding: 20px; background-color: #f0f2f5; color: #333; }
        h1 { text-align: center; color: #1a73e8; }
        .question-box { background: white; margin-bottom: 25px; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .question-text { font-weight: 600; margin-bottom: 15px; line-height: 1.5; font-size: 16px; }
        .option { display: block; margin: 12px 0; padding: 12px 15px; border: 1px solid #e0e0e0; border-radius: 8px; cursor: pointer; transition: all 0.2s ease; }
        .option:hover { background-color: #f8f9fa; border-color: #1a73e8; }
        .option input { margin-right: 12px; transform: scale(1.2); cursor: pointer; }
        #submit-btn { display: block; width: 100%; background-color: #1a73e8; color: white; padding: 15px; border: none; border-radius: 8px; font-size: 18px; font-weight: bold; cursor: pointer; margin-top: 30px; transition: background 0.3s; }
        #submit-btn:hover { background-color: #1557b0; }
        #result { text-align: center; font-size: 24px; font-weight: bold; color: #d93025; margin-top: 30px; padding: 20px; background: #fff; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); display: none; }
        .footer { text-align: center; margin-top: 30px; font-size: 14px; color: #777; }
    </style>
</head>
<body>

    <h1>Bài Thi Trắc Nghiệm PTHTTMDT</h1>
    <div id="quiz-container"></div>
    <button id="submit-btn" onclick="submitQuiz()">Nộp bài & Xem điểm</button>
    <div id="result"></div>
    <div class="footer">Tổng cộng: 125 câu hỏi</div>

    <script>
        const questions = [
            { q: "1. Ý nghĩa của tác vụ 'what' trong hệ thống TMĐT có ý nghĩa gì?", o: ["A. Các công việc cụ thể mà một người hoặc nhóm người hoàn thành", "B. Những người sử dụng hệ thống và những đối tượng liên quan", "C. Nội dung thông tin được cung cấp và hiển thị qua hệ thống", "D. Các công cụ được sử dụng để thực hiện các tác vụ"], a: "A" },
            { q: "2. Nhóm người dùng 'who' trong hệ thống TMĐT có ý nghĩa gì?", o: ["A. Những người sử dụng hệ thống và những đối tượng liên quan", "B. Nội dung thông tin được cung cấp và hiển thị qua hệ thống", "C. Các công cụ được sử dụng để thực hiện các tác vụ", "D. Các công việc cụ thể mà một người hoặc nhóm người hoàn thành"], a: "A" },
            { q: "3. Nội dung 'how' trong hệ thống TMĐT có ý nghĩa gì?", o: ["A. Nội dung thông tin được cung cấp và hiển thị qua hệ thống", "B. Các công cụ được sử dụng để thực hiện các tác vụ", "C. Các công việc cụ thể mà một người hoặc nhóm người hoàn thành", "D. Những người sử dụng hệ thống và những đối tượng liên quan"], a: "B" },
            { q: "4. Công cụ 'with what' trong hệ thống TMĐT có ý nghĩa gì?", o: ["A. Các công việc cụ thể mà một người hoặc nhóm người hoàn thành", "B. Các công cụ được sử dụng để thực hiện các tác vụ", "C. Những người sử dụng hệ thống và những đối tượng liên quan", "D. Nội dung thông tin được cung cấp và hiển thị qua hệ thống"], a: "B" },
            { q: "5. Phân tích hệ thống bao gồm mấy nội dung chính?", o: ["A. 2", "B. 3", "C. 4", "D. 5"], a: "B" },
            { q: "6. Nội dung chính của phân tích hệ thống là gì?", o: ["A. Xác định, phân tích và triển khai các yêu cầu của hệ thống", "B. Xác định yêu cầu đối với hệ thống", "C. Xác định và phân tích yêu cầu đối với hệ thống", "D. Xác định và phân tích mục đích của hệ thống"], a: "C" },
            { q: "7. Ý nghĩa của tác vụ 'what' trong hệ thống TMĐT có ý nghĩa gì? (Câu 7)", o: ["A. Những người sử dụng hệ thống và những đối tượng liên quan", "B. Nội dung thông tin được cung cấp và hiển thị qua hệ thống", "C. Các công cụ được sử dụng để thực hiện các tác vụ", "D. Các công việc cụ thể mà một người hoặc nhóm người hoàn thành"], a: "D" },
            { q: "8. Nhận định nào dưới đây là đúng về phân tích hệ thống thương mại điện tử?", o: ["A. Là việc thiết lập một tình huống kinh doanh cho một hệ thống TMĐT hay nói cách khác là xây dựng mô hình tổng thể của một hệ thống TMĐT cần xây dựng", "B. Là việc liệt kê, đánh giá công nghệ, nhân lực và chi phí cần cho phát triển một hệ thống thương mại điện tử", "C. Là việc phân tích tình khả thi của hệ thống thương mại điện tử", "D. Là việc phân tích rủi ro khi vận hành hệ thống thương mại điện tử"], a: "A" },
            { q: "9. Mô hình tổng thể của một hệ thống TMĐT cần phải được trình bày theo quan điểm của đối tượng nào?", o: ["A. Người sử dụng", "B. Khách hàng", "C. Nhà bán hàng", "D. Đối thủ cạnh tranh"], a: "A" },
            { q: "10. Phân tích hệ thống nhằm xác định điều gì đối với một hệ thống?", o: ["A. Mục đích đích thực của hệ thống", "B. Yêu cầu đích thực đối với một hệ thống", "C. Tầm nhìn của hệ thống", "D. Hiệu quả hệ thống mạng lại"], a: "B" },
            { q: "11. Để có tính khả thi về mặt kinh tế, một hệ thống phải đảm bảo một trong những điều nào dưới đây?", o: ["A. Có chi phí thấp hơn tổng chi cực đại cho phép", "B. Có chi phí thấp hơn hoặc bằng tổng chi cực đại cho phép", "C. Có chi phí bằng tổng chi cực đại cho phép", "D. Có chi phí cao hơn tổng chi cực đại cho phép"], a: "B" },
            { q: "12. Để có tính khả thi về mặt kinh tế, một hệ thống phải đảm bảo những điều gì?", o: ["A. Có chi phí thấp hơn tổng chi cực đại cho phép", "B. Vượt qua mức lợi ích kì vọng thấp nhất", "C. Đáp ứng được tất cả những kì vọng về khả năng thu lợi", "D. Tất cả đáp án trên"], a: "D" },
            { q: "13. Đánh giá sơ bộ tính khả thi về kinh tế có thể tiến hành bằng mấy cách?", o: ["A. 3", "B. 4", "C. 5", "D. 2"], a: "A" },
            { q: "14. Nhận định nào dưới đây không phải là một cách đánh giá sơ bộ tính khả thi về kinh tế?", o: ["A. Loại bỏ những chi phí không cần thiết", "B. Xác định những tiêu chí về chi phí và lợi nhuận", "C. Đánh giá mỗi tiêu chí trên cơ sở tầm quan trọng tiềm năng", "D. So sánh mức độ quan trọng của chi phí và lợi nhuận"], a: "D" },
            { q: "15. Tại sao hệ thống thông tin hiếm khi sở hữu giá trị thặng dư?", o: ["A. Không ai mua những phần mềm, dữ liệu đã cũ", "B. Có thể không ai mua những phần cứng đã cũ", "C. Phần cứng/ phần mềm hiện hành có thể vận cần cho một số ứng dụng khác và do đó không thể bị xoá bỏ", "D. Tất cả đáp án trên"], a: "D" },
            { q: "16. Trước khi đánh giá tính khả thi của một phương án phát triển hệ thống TMĐT, các nhà phát triển hệ thống cần xác định các phương án đưa ra là một trong các trường hợp nào?", o: ["A. Không làm gì: Cải tiến hệ thống đang tồn tại", "B. Không làm gì: Cải tiến hệ thống đang tồn tại; Mua lại hoặc sao chép một hệ thống có sẵn", "C. Không làm gì; Cải tiến hệ thống đang tồn tại, Mua lại hoặc sao chép một hệ thống có sẵn; Phát triển một hệ thống mới bền vững", "D. Mua lại hoặc sao chép một hệ thống có sẵn; Phát triển một hệ thống mới bền vững"], a: "C" },
            { q: "17. Những bên nào có đóng góp vào sự phát triển của hầu hết các hệ thống?", o: ["A. Người dùng trực tiếp sử dụng gói ứng dụng", "B. Nhà cung cấp hay nhận dữ liệu hoặc thông tin từ về ứng dụng", "C. Các nhà quản lí khác nhau liên quan đến những nhóm này", "D. Tất cả đáp án trên"], a: "D" },
            { q: "18. Nếu những lợi nhuận chủ yếu có thể đạt được mà không cần những chi phí chủ yếu hay quan trọng, thì hệ thống sẽ thế nào?", o: ["A. Khả thi hoàn toàn", "B. Khả thi nhưng có khó khăn đáng kể", "C. Không có tính khả thi hay khả thi nhưng có khó khăn đáng kể", "D. Không có tính khả thi"], a: "A" },
            { q: "19. Chi phí hữu hình điển hình gồm có những chi phí gì?", o: ["A. Chi phí phát triển, chi phí hoạt động, các khoản phí tiết kiệm được, cải tiến khả năng thu lợi", "B. Chi phí phát triển, chi phí hoạt động, các khoản phí tiết kiệm được", "C. Chi phí phát triển, chi phí hoạt động, cải tiến khả năng thu lợi", "D. Chi phí phát triển, chi phí hoạt động, các khoản phí tiết kiệm được, cải tiến khả năng thu lợi, chi phí duy trì"], a: "D" },
            { q: "20. Tại sao hệ thống thông tin hiếm khi sở hữu giá trị thặng dư? (Câu 20)", o: ["A. Không ai mua những phần mềm, dữ liệu đã cũ", "B. Có thể không ai mua những phần cứng đã cũ", "C. Phần cứng/ phần mềm hiện hành có thể vận cần cho một số ứng dụng khác và do đó không thể bị xoá bỏ", "D. Tất cả đáp án trên"], a: "D" },
            { q: "21. Tính khả thi về xử lí có thể được xác định bằng cách cân nhắc cái gì?", o: ["A. Cái gì được thực hiện trong vùng ứng dụng?", "B. Cái gì được thực hiện trong những vùng ứng dụng tương tự", "C. Cái gì được thực hiện với những loại thông tin tương tự", "D. Tất cả đáp án trên"], a: "D" },
            { q: "22. Tính khả thi về dữ liệu có thể được xác định bằng cách nào?", o: ["A. Xác định bằng cách đánh giá tính sẵn sàng của dữ liệu và thông tin đầu vào", "B. Xác định cái gì được thực hiện trong vùng ứng dụng?", "C. Xác định cái gì được thực hiện trong những vùng ứng dụng tương tự", "D. Xác định cái gì được thực hiện với những loại thông tin tương tự"], a: "A" },
            { q: "23. Tính khả thi về phát triển xem xét khả năng gì của tổ chức?", o: ["A. Khả năng một tổ chức có thể phát triển thành công hoàn toàn một phương án được đề xuất hay không", "B. Khả năng một tổ chức có thể phát triển thành công một phương án được đề xuất hay không", "C. Khả năng một tổ chức có đủ nguồn lực để phát triển thành công một phương án được đề xuất hay không", "D. Khả năng một tổ chức có đủ nhân lực để phát triển thành công một phương án được đề xuất hay không"], a: "B" },
            { q: "24. Nhận định nào dưới đây là đúng về lợi ích của việc nghiên cứu về tính khả thi của dự án phát triển hệ thống thương mại điện tử?", o: ["A. Giúp dự báo trước các tình huống, các vấn đề xảy ra nhằm tránh những sai lầm có thể dẫn đến sự thất bại cho hệ thống", "B. Giúp dự báo chi phí thực hiện dự án", "C. Giúp dự báo nguồn lực cần thiết cho dự án", "D. Giúp dự báo khả năng thành công của dự án"], a: "A" },
            { q: "25. Đánh giá về tính khả thi của hệ thống hay dự án phải được duy trì như thế nào?", o: ["A. Từ khi lập kế hoạch phát triển hệ thống đến khi vận hành thành công hệ thống", "B. Từ khi xây dựng hệ thống đều khi hoàn thiện theo kế hoạch xây dựng hệ thống", "C. Từ khi lập kế hoạch phát triển hệ thống đến khi hoàn thiện theo kế hoạch xây dựng hệ thống", "D. Từ khi xây dựng hệ thống cũng như trong suốt quá trình hoạt động và phát triển hệ thống"], a: "D" },
            { q: "26. Sự không khả thi về mặt chức năng khi đánh giá tính khả thi của dự án phát triển hệ thống thương mại điện tử được thể hiện như thế nào?", o: ["A. Không làm được hoặc làm nhưng kết quả không tốt", "B. Hoàn toàn không làm được", "C. Không đánh giá được kết quả của dự án", "D. Không thể hoàn thiện dự án"], a: "A" },
            { q: "27. Tại sao tính khả thi về mặt chức năng đôi khi cũng bị bỏ qua?", o: ["A. Vì nó tốn kém hơn so với tính khả thi về mặt kinh tế", "B. Vì nó khó thực hiện hơn so với tính khả thi về mặt kinh tế", "C. Vì nó khó định lượng hơn so với tính khả thi về mặt kinh tế", "D. Vì nó không cần thiết bằng tính khả thi về mặt kinh tế"], a: "C" },
            { q: "28. Yêu cầu về nội dung trong tính khả thi về mặt chức năng là gì?", o: ["A. Phải luôn được cập nhật", "B. Phải luôn cố định, không thay đổi theo thời gian", "C. Phải luôn mới", "D. Phải luôn được kiểm định trước khi đưa ra"], a: "A" },
            { q: "29. Tính khả thi về mặt kỹ thuật trả lời câu hỏi gì?", o: ["A. Liệu một hệ thống thương mại điện tử có được xây dựng theo cách thức thích hợp hay không?", "B. Liệu một hệ thống thương mại điện tử xây dựng có khó không?", "C. Liệu một hệ thống thương mại điện tử cần những cơ sở kỹ thuật nào", "D. Liệu một hệ thống thương mại điện tử có cần đầu tư kỹ thuật công nghệ mới không"], a: "A" },
            { q: "30. Tính khả thi về kỹ thuật bao gồm?", o: ["A. Tính khả thi về xử lý. Tính khả thi về dữ liệu. Tính khả thi về phát triển", "B. Tính khả thi về xử lý. Tính khả thi về dữ liệu", "C. Tính khả thi về dữ liệu, Tính khả thi về phát triển", "D. Tính khả thi về phát triển, Tính khả thi về xử lý"], a: "A" },
            { q: "31. Nhận định nào dưới đây là đúng về ý tưởng trong động lực phát triển hệ thống thương mại điện tử?", o: ["A. Ý tưởng là tập hợp một chuỗi những suy nghĩ nhằm thực hiện giải quyết một vấn đề, công việc cụ thể", "B. Ý tưởng khởi nguồn từ nhu cầu cuộc sống và kết thúc bằng việc phục vụ cuộc sống", "C. Một ý tưởng giá trị mang lại lợi ích riêng cho doanh nghiệp/tổ chức, lợi ích chung cho cộng đồng", "D. Tất cả các đáp án trên"], a: "D" },
            { q: "32. Bản kế hoạch dự án trong bước lập kế hoạch và đánh giá dự án phát triển hệ thống thương mại điện tử cho biết điều gì?", o: ["A. Cho biết kế hoạch chi tiết của các hoạt động cần được hoàn thành để phát triển một hệ thống cụ thể và các nguồn lực sẽ được phân bổ để thực hiện chúng", "B. Cho biết kế hoạch tổng quan của các hoạt động cần được hoàn thành để phát triển một hệ thống cụ thể và các nguồn lực sẽ được phân bổ để thực hiện chúng", "C. Chỉ ra các bước trong quá trình thực hiện dự án", "D. Cho biết kế hoạch chi tiết, nhân lực phân bổ và chi phí triển khai"], a: "A" },
            { q: "33. Tính khả thi về kinh tế khác với tính khả thi về lợi nhuận ở điểm nào?", o: ["A. Hệ thống khả thi về lợi nhuận là hệ thống có chi phí thấp hơn", "B. Một hệ thống khả thi về mặt kinh tế có thể không sinh ra lợi nhuận", "C. Nhận được mức hỗ trợ khác nhau từ chính phủ", "D. Có cách thức triển khai hệ thống khác nhau"], a: "B" },
            { q: "34. Tính khả thi về kinh tế có thể tác động đến những vấn đề nào của tổ chức?", o: ["A. Việc tiến hành phân tích chi phí - lợi nhuận của quá trình phát triển một hệ thống", "B. Tiềm năng về lợi nhuận có thể đạt được nhờ phát triển hệ thống", "C. Khả năng thua lỗ nếu hệ thống không được phát triển", "D. Tất cả đáp án trên"], a: "D" },
            { q: "35. Để có tính khả thi về mặt kinh tế, một hệ thống phải đảm bảo điều gì?", o: ["A. Có chi phí thấp hơn tổng chi cực đại cho phép. Nếu một HT có chi phí quá cao thì không cần phải xét đến HT đó", "B. Vượt qua được lợi ích ở mức kì vọng thấp nhất", "C. Đáp ứng được tất cả những kì vọng về khả năng thu lại", "D. Tất cả đáp án trên"], a: "D" },
            { q: "36. Nhận định nào dưới đây là yếu tố để xây dựng ý tưởng?", o: ["A. Đọc nhiều hơn", "B. Học sáng tạo từ nhỏ", "C. Mở rộng các ý tưởng cũ", "D. Tất cả các đáp án trên"], a: "D" },
            { q: "37. Nhận định nào dưới đây là đúng với khả thi về xử lý trong tính khả thi về mặt kỹ thuật?", o: ["A. Các tác vụ được xử lí thuộc lĩnh vực ứng dụng nào, Có phù hợp với các lĩnh vực ứng dụng tương tự khác không. Có phù hợp với các loại thông tin tương tự không", "B. Các dữ liệu thông tin (đầu vào của các ứng dụng) có giá trị không", "C. Xác định khả năng thành công của tổ chức khi phát triển hệ thống", "D. Không có đáp án nào đúng"], a: "A" },
            { q: "38. Nhận định nào dưới đây là đúng với khả thi về dữ liệu trong tính khả thi về mặt kỹ thuật?", o: ["A. Các dữ liệu thông tin (đầu vào của các ứng dụng) có giá trị không", "B. Xác định khả năng thành công của tổ chức khi phát triển hệ thống", "C. Không có đáp án nào đúng", "D. Các tác vụ được xử lí thuộc lĩnh vực ứng dụng nào, Có phù hợp với các lĩnh vực ứng dụng tương tự khác không. Có phù hợp với các loại thông tin tương tự không"], a: "A" },
            { q: "39. Nhận định nào dưới đây là đúng với khả thi về phát triển trong tính khả thi về mặt kỹ thuật?", o: ["A. Không có đáp án nào đúng", "B. Xác định khả năng thành công của tổ chức khi phát triển hệ thống", "C. Các tác vụ được xử lí thuộc lĩnh vực ứng dụng nào; Có phù hợp với các lĩnh vực", "D. Các dữ liệu thông tin (đầu vào của các ứng dụng) có giá trị không"], a: "B" },
            { q: "40. Nhận định nào dưới đây là đúng với tính khả thi về kinh tế?", o: ["A. Xác định việc doanh nghiệp có nên chi (tiêu tốn) các nguồn lực cho việc xây dựng các hệ thống đó không", "B. Trả lời cho câu hỏi liệu một hệ thống TMĐT có được xây dựng theo cách thức thích hợp hay không.", "C. Chỉ được tiến hành một cách đúng đắn khi một bản thiết kế đã được phát triển", "D. Tất cả các đáp án trên"], a: "A" },
            { q: "41. Nhận định nào dưới đây là đúng về tính khả thi về mặt kỹ thuật?", o: ["A. Trả lời cho câu hỏi liệu một hệ thống TMĐT có được xây dựng theo cách thức thích hợp hay không", "B. Luôn thay đổi theo yêu cầu và đáp ứng tốt hơn yêu cầu của người sử dụng", "C. Xử lí được nhiều giao dịch trong một thời gian nhất định", "D. Đảm bảo hệ thống tránh được những thiệt hại"], a: "A" },
            { q: "42. Xác định tính khả thi về kĩ thuật chỉ được tiến hành một cách đúng đắn khi nào?", o: ["A. Khi có ý tưởng về một bản thiết kế", "B. Khi bản thiết kế đã được tiến hành", "C. Khi một bản thiết kế đã được phát triển", "D. Khi xảy ra rủi ro trong bản thiết kế"], a: "C" },
            { q: "43. Có mấy mức khả thi về kĩ thuật?", o: ["A. 3", "B. 4", "C. 5", "D. 6"], a: "A" },
            { q: "44. Khả thi về mặt kỹ thuật bao gồm những mức nào?", o: ["A. Bất khả thi, khả thi nhưng có khó khăn đáng kể, khả thi hoàn toàn", "B. Bất khả thi, khả thi trung bình, khả thi hoàn toàn", "C. Bất khả thi, khả thi hoàn toàn", "D. Bất khả thi, khả thi tương đối, khả thi hoàn toàn"], a: "A" },
            { q: "45. Đặc điểm của khả thi nhưng có khó khăn đáng kể trong tính khả thi về mặt kỹ thuật là", o: ["A. Có thể thực hiện được nhưng sẽ có những khó khăn phải vượt qua để đạt được những lợi ích kì vọng", "B. Có thể thực hiện được và được kì vọng để thực hiện", "C. Tất cả các đáp án trên", "D. Việc thực hiện sẽ dẫn đến những hậu quả nghiêm trọng"], a: "A" },
            { q: "46. Đặc điểm của khả thi hoàn toàn trong tính khả thi về mặt kỹ thuật là gì?", o: ["A. Có thể thực hiện được và được kì vọng để thực hiện", "B. Tất cả các đáp án trên", "C. Việc thực hiện sẽ dẫn đến những hậu quả nghiêm trọng", "D. Có thể thực hiện được nhưng sẽ có những khó khăn phải vượt qua để đạt được những lợi ích kì vọng"], a: "A" },
            { q: "47. 'Việc thực hiện sẽ dẫn đến những hậu quả nghiêm trọng' là đặc điểm của mức độ khả thi nào trong tính khả thi về mặt kỹ thuật?", o: ["A. Bất khả thi", "B. Khả thi nhưng có khó khăn đáng kể", "C. Khả thi hoàn toàn", "D. Khả thi tương đối"], a: "A" },
            { q: "48. 'Có thể thực hiện được nhưng sẽ có những khó khăn phải vượt qua để đạt được những lợi ích kì vọng' là đặc điểm của mức độ khả thi nào trong tính khả thi về mặt kỹ thuật.", o: ["A. Khả thi nhưng có khó khăn đáng kể", "B. Khả thi hoàn toàn", "C. Khả thi tương đối", "D. Bất khả thi"], a: "A" },
            { q: "49. Tổng thể tính khả thi về mặt chức năng bao gồm mấy trường hợp?", o: ["A. 3", "B. 4", "C. 5", "D. 2"], a: "A" },
            { q: "50. Tổng thể tính khả thi về mặt chức năng bao gồm những trường hợp nào?", o: ["A. Không khả thi", "B. Khó có thể làm được", "C. Thực hiện dễ dàng và kết quả tốt", "D. Tất cả đáp án trên"], a: "D" },
            { q: "51. Tính khả thi về mặt chức năng liên quan đến việc hệ thống có đáp ứng được điều gì?", o: ["A. Yêu cầu mà người sử dụng hoặc những người liên quan đến hệ thống đưa ra", "B. Có được họ chấp nhận hay không?", "C. Có được họ sử dụng hay không?", "D. Tất cả các đáp án trên"], a: "D" },
            { q: "52. Lợi ích của việc quản trị rủi ro phát triển hệ thống thương mại điện tử được đo lường thông qua đâu?", o: ["A. Tổng chi phí của từng thiệt hại riêng biệt", "B. Tổng chi phí trong từng giai đoạn", "C. Tổng chi phí doanh nghiệp bỏ ra để khắc phục hậu quả", "D. Tổng chi phí cơ hội đến từ các rủi ro"], a: "D" },
            { q: "53. Nhận định nào dưới đây là đúng về tính khả thi của dự án phát triển hệ thống thương mại điện tử?", o: ["A. Tính khả thi liên quan tới khả năng mà một hệ thống có thể có được hoặc được phát triển nhằm đáp ứng một mục tiêu nào đó trong một điều kiện môi trường nhất định", "B. Nghiên cứu về tính khả thi giúp dự báo trước các tình huống, các vấn đề xảy ra nhằm tránh những sai lầm có thể dẫn đến sự thất bại cho hệ thống", "C. Đánh giá về tính khả thi của hệ thống hay dự án phải được duy trì: từ khi xây dựng hệ thống cũng như trong suốt quá trình hoạt động và phát triển hệ thống", "D. Tất cả các đáp án trên"], a: "D" },
            { q: "54. Có mấy khía cạnh về tính khả thi của dự án phát triển hệ thống thương mại điện tử?", o: ["A. 3", "B. 4", "C. 5", "D. 2"], a: "A" },
            { q: "55. Tổng thể tính khả thi về mặt chức năng bao gồm mấy trường hợp? (Câu 55)", o: ["A. 3", "B. 4", "C. 5", "D. 2"], a: "A" },
            { q: "56. Tổng thể tính khả thi về mặt chức năng bao gồm những trường hợp nào? (Câu 56)", o: ["A. Không khả thi", "B. Khi có thể làm được", "C. Thực hiện dễ dàng và kết quả tốt", "D. Tất cả đáp án trên"], a: "D" },
            { q: "57. Tính khả thi về mặt chức năng liên quan đến việc hệ thống có đáp ứng được điều gì? (Câu 57)", o: ["A. Yêu cầu mà người sử dụng hoặc những người liên quan đến hệ thống đưa ra", "B. Có được họ chấp nhận hay không?", "C. Có được họ sử dụng hay không?", "D. Tất cả các đáp án trên"], a: "D" },
            { q: "58. Có mấy nhóm đối tượng có thể đưa ra chỉ thị nhằm thúc đẩy động lực phát triển hệ thống thương mại điện tử?", o: ["A. 3", "B. 2", "C. 4", "D. 5"], a: "A" },
            { q: "59. Có mấy hoạt động cơ bản cần thực hiện khi hình thành một dự án phát triển hệ thống thương mại điện tử", o: ["A. 4", "B. 5", "C. 6", "D. 7"], a: "B" },
            { q: "60. Khi hình thành một dự án phát triển hệ thống thương mại điện tử cần thực hiện những hoạt động cơ bản nào?", o: ["A. Lập kế hoạch và đánh giá; Phân bổ nguồn lực", "B. Kiểm soát và ra quyết định", "C. Quản trị rủi ro", "D. Tất cả các đáp án trên"], a: "D" },
            { q: "61. Hoạt động nào dưới đây không phải là một trong những hoạt động cần thực hiện khi hình thành một dự án phát triển hệ thống thương mại điện tử?", o: ["A. Huy động vốn đầu tư", "B. Lập kế hoạch và đánh giá", "C. Kiểm soát và ra quyết định", "D. Quản trị rủi ro"], a: "A" },
            { q: "62. 'Một Yêu cầu mới được áp đặt bởi nhà quản lý, chính phủ hoặc bộ phận có ảnh hưởng nào đó từ bên ngoài' là Yếu tố nào trong động lực phát triển hệ thống thương mại điện tử", o: ["A. Chỉ thị", "B. Không có đáp án nào đúng", "C. Vấn đề", "D. Cơ hội"], a: "A" },
            { q: "63. Nhận định nào dưới đây là đúng về vấn đề trong động lực phát triển hệ thống thương mại điện tử?", o: ["A. Có rất nhiều vấn đề có thể xảy ra trong quá trình hoạt động kinh doanh như cạnh tranh, nhu cầu thay đổi, phạm vi mở rộng hoặc thu hẹp thị trường", "B. Quá trình này liên tục xảy ra", "C. Quá trình này liên tục phải phát triển", "D. Tất cả các đáp án trên"], a: "D" },
            { q: "64. Nhận định nào dưới đây là sai về vấn đề trong động lực phát triển hệ thống thương mại điện tử?", o: ["A. Được xuất hiện kèm theo một điều kiện hoàn toàn mới như ý tưởng kinh doanh, công nghệ, ngân sách đầu tư", "B. Có rất nhiều vấn đề có thể xảy ra trong quá trình hoạt động kinh doanh như cạnh tranh, nhu cầu thay đổi, phạm vi mở rộng hoặc thu hẹp thị trường", "C. Quá trình này liên tục xảy ra", "D. Quá trình này liên tục phải phát triển"], a: "A" },
            { q: "65. Nhận định nào dưới đây là đúng về cơ hội trong động lực phát triển hệ thống thương mại điện tử?", o: ["A. Xuất hiện kèm theo một điều kiện hoàn toàn mới như ý tưởng kinh doanh, công nghệ, ngân sách đầu tư", "B. Tất cả các đáp án trên", "C. Nhu cầu thay đổi, phạm vi mở rộng hoặc thu hẹp thị trường", "D. Thay đổi về điều kiện thực tế nào đó nên cần sự thay đổi về hệ thống, công nghệ, quy trình"], a: "A" },
            { q: "66. Nhận định nào dưới đây là sai về cơ hội trong động lực phát triển hệ thống thương mại điện tử?", o: ["A. Có rất nhiều vấn đề có thể xảy ra trong quá trình hoạt động kinh doanh như cạnh tranh, nhu cầu thay đổi, phạm vi mở rộng hoặc thu hẹp thị trường", "B. Quá trình này liên tục xảy ra", "C. Quá trình này liên tục phải phát triển", "D. Tất cả các đáp án trên"], a: "D" },
            { q: "67. Chỉ thị trong động lực phát triển hệ thống thương mại điện tử có thể bắt nguồn từ đâu?", o: ["A. Chính phủ", "B. Khách hàng", "C. Nhân viên", "D. Đối thủ cạnh tranh"], a: "A" },
            { q: "68. Những đối tượng nào có thể đưa ra chỉ thị nhằm thúc đẩy động lực phát triển hệ thống thương mại điện tử", o: ["A. Chính phủ, lãnh đạo tổ chức, đối tác kinh doanh", "B. Chính phủ, khách hàng, đối tác kinh doanh", "C. Chính phủ, nhân viên, đối tác kinh doanh", "D. Chính phủ, đối thủ cạnh tranh, khách hàng tiêu của nó"], a: "A" },
            { q: "69. Yếu tố 'chỉ thị' trong động lực phát triển hệ thống thương mại điện tử là gì?", o: ["A. Là một Yêu cầu mới được áp đặt bởi nhà quản lý, chính phủ hoặc bộ phận có ảnh hưởng nào đó từ bên ngoài", "B. Không có đáp án nào đúng", "C. Là một trạng thái khó khăn trong thực tế ngăn cản tổ chức đạt được mục đích, mục tiêu của nó", "D. Là một cơ hội để cải thiện tổ chức (thay đổi hệ thống) cho dù không có vấn đề nào được xác định"], a: "A" },
            { q: "70. 'Một trạng thái khó khăn trong thực tế ngăn cản tổ chức đạt được mục đích, mục tiêu của nó' là Yếu tố nào trong động lực phát triển hệ thống thương mại điện tử?", o: ["A. Vấn đề", "B. Cơ hội", "C. Chỉ thị", "D. Tất cả các đáp án trên"], a: "A" },
            { q: "71. 'Một cơ hội để cải thiện tổ chức (thay đổi hệ thống) cho dù không có vấn đề nào được xác định' là yếu tố nào trong động lực phát triển hệ thống thương mại điện tử", o: ["A. Cơ hội", "B. Chỉ thị", "C. Không có đáp án nào đúng", "D. Vấn đề"], a: "A" },
            { q: "72. Động lực phát triển hệ thống thương mại điện tử bao gồm mấy yếu tố", o: ["A. 3", "B. 4", "C. 2", "D. 5"], a: "A" },
            { q: "73. Yếu tố 'vấn đề' trong động lực phát triển hệ thống thương mại điện tử là gì?", o: ["A. Là một trạng thái khó khăn trong thực tế ngăn cản tổ chức đạt được mục đích, mục tiêu của nó", "B. Là một cơ hội để cải thiện tổ chức (thay đổi hệ thống) cho dù không có vấn đề nào được xác định", "C. Là một Yêu cầu mới được áp đặt bởi nhà quản lý, chính phủ hoặc bộ phận có ảnh hưởng nào đó từ bên ngoài", "D. Không có đáp án nào đúng"], a: "A" },
